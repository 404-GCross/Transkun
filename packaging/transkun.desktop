[Desktop Entry]
Type=Application
Name=Transkun
Name[zh_CN]=Transkun 扒谱
Comment=Piano audio to MIDI
Comment[zh_CN]=把钢琴音频转写成 MIDI
Exec=transkun-app --gui %F
Icon=transkun
